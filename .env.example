# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get your token from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Telegram ID of the primary super admin (obtain via @userinfobot)
ADMIN_ID=123456789

# Optional: Comma-separated list of additional admin Telegram IDs
# ADDITIONAL_ADMINS=987654321,112233445

# Bot Username (without @ symbol, e.g., MyReferralRewardBot)
BOT_USERNAME=MyCouponBot

# ==========================================
# Database Configuration
# ==========================================
# Default: SQLite with async driver (aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# For PostgreSQL in production (Railway/Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ==========================================
# Business Rules & Rewards Settings
# ==========================================
# Points awarded per successful referral (Default: 1)
POINTS_PER_REFERRAL=1

# Required Channels Configuration
CHANNEL_1=@OfferRaider
CHANNEL_2=@OfferMate
CHANNEL_3=@Grabmint

# Optional additional seed channels (comma-separated)
DEFAULT_REQUIRED_CHANNELS=

# ==========================================
# Telegram WebApp Device Verification
# ==========================================
# Public HTTPS URL of the WebApp (e.g. https://yourdomain.com/verify or Ngrok URL)
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ==========================================
# Logging & Monitoring
# ==========================================
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
